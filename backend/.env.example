# Copiar a .env y reemplazar los marcadores. .env no se versiona.
# Referencia completa de cada variable: docs/desarrollo-local.md

# --- Django ---
# Obligatoria. Generarla con:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=reemplazar-por-una-clave-aleatoria

# Los valores siguientes son los predeterminados de config.settings.local;
# solo hace falta definirlos para cambiarlos.
# DJANGO_DEBUG=true
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Orígenes del frontend admitidos por CORS y CSRF (separados por comas).
# DJANGO_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Cookies con atributo Secure (exige HTTPS). En local, false.
# DJANGO_SECURE_COOKIES=false
# SameSite de las cookies que usa la SPA (CSRF y renovación).
# DJANGO_COOKIE_SAMESITE=Lax
# Proxies de confianza delante de Django, para obtener la IP en la limitación de intentos.
# DJANGO_NUM_PROXIES=0

# --- PostgreSQL (los lee compose.yaml y Django) ---
POSTGRES_DB=artesanic
POSTGRES_USER=artesanic
POSTGRES_PASSWORD=reemplazar-por-una-contrasena-local
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434
